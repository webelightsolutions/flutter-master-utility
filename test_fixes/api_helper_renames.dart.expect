import 'package:master_utility/master_utility.dart';

void main() {
  final APIRequest request = APIRequest(
    url: '/users',
    methodType: MethodType.POST,
    body: {'name': 'Asha'},
    bodyList: [1],
    headers: {'x': '1'},
    requiresAuth: false,
  );
  request.body = {'name': 'Ravi'};
  print(request.bodyList);
  print(request.headers);
  print(request.requiresAuth);

  APIConstError.somethingWentWrong = 'Oops';
  print(APIConstError.connectionFailed);
  print(APIConstError.connectionTimeout);
  print(APIConstError.invalidStatusCode(statusCode: 500));

  print(APIService().joinValidationMessages(null));
  print(ErrorHandler.instance.messageFor(DioException(requestOptions: RequestOptions())));
}
